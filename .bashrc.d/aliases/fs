# .bashrc.d  .gnupg      .npm     .ssh         .BUILDINFO   .MTREE
# .cargo     .local      .nvm     .var         .for-espeak  .npmrc
# .minecraft  .pki     .vscode-oss  .gitconfig   .PKGINFO
# .fortune   .mozilla    .rustup  .zen go   .gtkrc-2.0   .wget-hsts

IGNORE_GLOB=$(IFS='|'; echo "-I \"${ignore_list[*]}\"")

# Filesystem / listing
alias ls="eza -a $IGNORE_GLOB  --icons=always --no-quotes --group-directories-first"
alias ll="eza -al $IGNORE_GLOB --icons=always --no-quotes --group-directories-first"
alias la="eza -aa --icons=always --no-quotes --group-directories-first"
alias lla="eza -aal --icons=always --no-quotes --group-directories-first"
alias lt="eza -a $IGNORE_GLOB  --tree --level=1 --icons=always --no-quotes --group-directories-first"

# Remove
alias rm='rm -Irv'

# Lsblk
alias lsblk='lsblk -o name,label,mountpoints,fsuse%,fssize'
alias jlsblk='blkid'
alias flsblk='lsblk -o name,fstype,label,partuuid,mountpoints,fsuse%,fssize'

# Copy
alias cp='cp --reflink=auto  -rv'
alias cc='cp --reflink=always -rv'
alias cpm='cp --reflink=never -rv'

# Perms
alias chmod='chmod -R'
alias chown='chown -R'

# Move
alias mv='mv -vS .bak'
alias mvf='mv -vfS .bak'

# Rsync
alias rs='rsync --status=progress'
alias rsync='rsync --status=progress'
